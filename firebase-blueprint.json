    "Booking": {
      "title": "Booking",
      "description": "Tour reservation record including passenger PII, status, and optional advisor metadata.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique booking document ID."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "reference": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[A-Z0-9\\-]+$",
          "description": "Booking voucher reference code (TourCodeYYMMDD-XXX)."
        },
        "tourCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[A-Z0-9\\-]+$",
          "description": "Standardized tour code."
        },
        "tourId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Tour identifier."
        },
        "tourSlug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "URL slug of the tour."
        },
        "tourTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Human-readable tour title."
        },
        "tourImage": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "description": "Tour thumbnail image URL."
        },
        "departureDate": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20,
          "description": "Departure date ISO string."
        },
        "guests": {
          "type": "integer",
          "description": "Number of passengers booked."
        },
        "totalPriceCents": {
          "type": "integer",
          "description": "Total booking amount in minor currency units."
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 6,
          "enum": ["USD", "EUR", "GBP", "AUD", "NZD", "CAD"],
          "description": "ISO 4217 currency code."
        },
        "leadName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Lead passenger full name."
        },
        "leadEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Lead passenger email."
        },
        "leadPhone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Lead passenger phone number."
        },
        "specialRequests": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000,
          "description": "Optional special requests."
        },
        "emergencyContactName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Optional emergency contact name."
        },
        "emergencyContactPhone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Optional emergency contact phone."
        },
        "dietaryNotes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000,
          "description": "Optional dietary requirements."
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["paid", "deposit_paid", "pending", "refunded"],
          "description": "Payment reconciliation status."
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "pending", "cancelled"],
          "description": "Booking lifecycle state; cancelled is terminal for non-staff."
        },
        "assignedGuide": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Assigned licensed guide name."
        },
        "internalNotes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000,
          "description": "Operations internal notes."
        },
        "isAdvisorBooking": {
          "type": "boolean",
          "description": "Whether the reservation was created through the Travel Advisor portal."
        },
        "advisorAgencyName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160,
          "description": "Travel advisor agency name."
        },
        "advisorName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Travel advisor full name."
        },
        "advisorEmail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 254,
          "description": "Travel advisor email address."
        },
        "commissionRatePercent": {
          "type": "number",
          "description": "Travel advisor commission rate percentage."
        },
        "financeNotified": {
          "type": "boolean",
          "description": "Whether finance reconciliation has been notified."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of booking creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last booking update."
        }
      },
      "required": [
        "id",
        "userId",
        "reference",
        "tourCode",
        "tourId",
        "tourSlug",
        "tourTitle",
        "departureDate",
        "guests",
        "totalPriceCents",
        "currency",
        "leadName",
        "leadEmail",
        "paymentStatus",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
